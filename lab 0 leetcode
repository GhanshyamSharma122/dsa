void swap(int *a,int *b){
    int temp=*a;
    *a=*b;
    *b=temp;
}
void moveZeroes(int* nums, int numsSize) {
    int i=0;
    int j=1;
    if(numsSize==1)
        return;
    while(j!=numsSize){
       if(nums[i]==0 && nums[j]!=0){
           swap(&nums[i++],&nums[j++]);
       } else if(nums[i]==0 && nums[j]==0){
           j++;
       }else{
           i++;
           j++;
       }
    }
}
